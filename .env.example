# GrowGreens — variáveis de ambiente (todas OPCIONAIS)
# A app funciona 100% offline sem nenhuma destas. Só são precisas para ativar a cloud.

# Supabase (contas + sincronização). Deixa vazio para correr local-first.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Segredos de Edge Functions (NUNCA no cliente — definir com `supabase secrets set`):
#   KINDWISE_API_KEY=...
#   OPENAI_API_KEY=...
